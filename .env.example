# ============================================================================
# GeoCampo - Configuración de Variables de Entorno (Local / Railway / Render)
# ============================================================================

# Puerto del servidor HTTP
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# Conexión a Base de Datos MySQL
# En Railway o Render podés usar directamente DATABASE_URL (o MYSQL_URL)
# Ejemplo: mysql://usuario:password@host.railway.internal:3306/railway
# ----------------------------------------------------------------------------
DATABASE_URL=

# O bien configurar los parámetros individuales de MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=geocampo_db

# Si MySQL no está corriendo en entorno local de desarrollo, permite usar
# el motor relacional local con persistencia JSON (cambiar a false en producción)
DB_FALLBACK_LOCAL=true

# ----------------------------------------------------------------------------
# Seguridad y Autenticación JWT
# ----------------------------------------------------------------------------
JWT_SECRET=geocampo_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=12h
PASSWORD_EXPIRY_DAYS=180
MAX_LOGIN_ATTEMPTS=5
PASSWORD_HISTORY_LIMIT=3
DIAS_DESCANSO_POTRERO=30

# ----------------------------------------------------------------------------
# Servicio de Correo (Opcional - para envío real de token de recuperación)
# Si se deja vacío, el sistema simula el envío en consola y respuesta de UI
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GeoCampo Soporte <no-reply@geocampo.agro>"
